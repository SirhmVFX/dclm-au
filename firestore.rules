rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // pageViews — anyone can write (anonymous tracking), nobody can read from client
    match /pageViews/{docId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // itemViews — anyone can write (per-item counters), nobody can read from client
    match /itemViews/{docId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // All other collections are publicly readable, only authenticated admins can write
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
